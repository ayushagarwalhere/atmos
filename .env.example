# Copy to .env in the project root. Credentials stay on the backend.
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
ATMOS_REFRESH_MINUTES=60
# Start in demo mode. Real data is never replaced with demo records.
ATMOS_DEFAULT_MODE=demo
ATMOS_AGENT_PROVIDER=local_rules
# Set provider to ollama or bedrock to enable Strands language-model agents.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# Optional delivery: defaults off; demo alerts are never sent.
ALERT_SEND_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
