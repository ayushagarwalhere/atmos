# Profile name only; AWS credentials stay in the normal SDK credential store.
AWS_PROFILE=your-profile-name
AWS_REGION=your-region
ATMOS_EXPECTED_AWS_ACCOUNT=your-12-digit-account-id
ATMOS_AGENT_PROVIDER=bedrock
# Choose a tool-capable model/inference profile available in your account/region.
BEDROCK_MODEL_ID=your-bedrock-model-or-inference-profile-id
# Verify current model/region pricing before filling these rates.
ATMOS_BEDROCK_INPUT_USD_PER_MILLION=0
ATMOS_BEDROCK_OUTPUT_USD_PER_MILLION=0
ATMOS_BEDROCK_RESERVATION_LIMIT_USD=5
ATMOS_AWS_MODE=aws
# Keep false until the concrete resource stack and cloud writes are approved.
ATMOS_AWS_ALLOW_WRITES=false
# Fill these from infra/cloud.yaml outputs after the reviewed stack is created.
ATMOS_S3_BUCKET=
ATMOS_DYNAMODB_TABLE=
ATMOS_SQS_QUEUE=
ATMOS_ANALYSIS_QUEUE=local
# External messages are a separate opt-in.
ALERT_SEND_ENABLED=false
